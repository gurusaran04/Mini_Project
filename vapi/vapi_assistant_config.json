{
  "name": "Student Leave & OD Voice Assistant",
  "transcriber": {
    "provider": "deepgram",
    "model": "nova-2",
    "language": "en-US"
  },
  "model": {
    "provider": "openai",
    "model": "gpt-4o-mini",
    "temperature": 0.3,
    "systemPrompt": "FILE_REF: ./system_prompt.txt",
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "submitLeaveODRequest",
          "description": "Submits structured leave or on-duty request gathered during the voice call to the n8n webhook backend.",
          "parameters": {
            "type": "object",
            "properties": {
              "parentPhoneNumber": {
                "type": "string",
                "description": "E.164 formatted phone number of the calling parent e.g. +15559876543"
              },
              "requestType": {
                "type": "string",
                "enum": ["Leave", "OD"],
                "description": "Whether the request is for standard Leave or official On-Duty (OD)"
              },
              "startDate": {
                "type": "string",
                "description": "Start date formatted as YYYY-MM-DD"
              },
              "endDate": {
                "type": "string",
                "description": "End date formatted as YYYY-MM-DD"
              },
              "durationDays": {
                "type": "integer",
                "description": "Total number of days"
              },
              "reason": {
                "type": "string",
                "description": "Verbatim or concise summarized reason for absence/OD"
              }
            },
            "required": ["parentPhoneNumber", "requestType", "startDate", "endDate", "durationDays", "reason"]
          }
        }
      }
    ]
  },
  "voice": {
    "provider": "elevenlabs",
    "voiceId": "21m00Tcm4TlvDq8ikWAM",
    "stability": 0.5,
    "similarityBoost": 0.75
  },
  "serverUrl": "https://your-n8n-instance.com/webhook/vapi-ivr-end-call",
  "endCallPhrases": ["have a wonderful day", "goodbye", "thank you for calling"]
}
